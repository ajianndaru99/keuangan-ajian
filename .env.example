# ==============================================================================
# Dashboard Keuangan Keluarga - Environment Variables
# ==============================================================================

# Supabase Project Configuration (Didapatkan dari Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (HANYA untuk Edge Functions & Backend - JANGAN PERNAH expose ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Webhook Secret API Key (Wajib diisi & cocokkan dengan header 'X-API-KEY' pada HTTP Request MacroDroid)
# Diset di Supabase CLI via: supabase secrets set WEBHOOK_API_KEY=kunci_rahasia_keluarga_123
WEBHOOK_API_KEY=kunci_rahasia_keluarga_123

# Default Household ID (Opsional: UUID household jika ingin diarahkan langsung tanpa lookup)
# DEFAULT_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000
