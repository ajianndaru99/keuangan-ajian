# ==============================================================================
# Dashboard Keuangan Keluarga - Environment Variables
# Jalur Ingestion: Screenshot Bukti Transaksi + Vision AI Google Gemini
# ==============================================================================

# Supabase Project Configuration (Didapatkan dari Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (HANYA untuk Edge Functions & Backend - JANGAN PERNAH expose ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Webhook Secret API Key (Wajib diisi & cocokkan dengan header 'X-API-KEY' pada HTTP Request MacroDroid / iOS Shortcuts)
WEBHOOK_API_KEY=kunci_rahasia_keluarga_minimal_32_karakter

# Google Gemini API Key (Untuk ekstraksi Vision AI multimodal bukti transfer)
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Model Gemini Vision (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# Telegram Financial Bot & Scheduled Nudges
# ==============================================================================
# Token otentikasi bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Daftar ID chat atau ID grup keluarga yang diizinkan memicu perintah bot (dipisah koma)
# Catatan: ID grup Telegram biasanya diawali tanda minus (-100xxxxxxxxx)
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890,987654321

# Token rahasia acak untuk memverifikasi keaslian webhook Telegram (Header: X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=rahasia_webhook_telegram_keluarga_99

# Token rahasia otorisasi untuk memicu cron terjadwal via Vercel Cron
CRON_SECRET=cron_secret_token_keluarga_123
